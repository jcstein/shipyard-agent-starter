# Dry-run is the default. It fetches a real 402 quote, writes receipt lines,
# and records a mocked Mocha post. It does not spend TIA or take payment.
DEMO_MODE=dry-run

# Eden wallet that pays Houston Inference. 32-byte hex. Never commit this.
# EDEN_PRIVATE_KEY=0x...

# Hard cap enforced in this process, before any transaction is signed.
# Denominated in TIA, not GBP. Raise it only for money you can lose.
SPEND_CAP_TIA=0.05

# Optional second cap in USD, using the TIA/USD price inside the 402 quote.
# SPEND_CAP_USD=1

HOUSTON_BASE_URL=https://inference.bot.fun/v1
HOUSTON_MODEL=qwen/qwen-flash
HOUSTON_MAX_TOKENS=32
# Client Payment-Signature is EIP-191 over these quote bytes.
# "nonce" matches the server's paymentId signature shape. "paymentId" is the alternate.
HOUSTON_SIGN_FIELD=nonce

# Pin. deposit/build must target this contract or the client refuses to sign.
ESCROW_ADDRESS=0x65d77c98E73DFbEA91eCb72B27c9753e186a94c8

# celestia-node light node (or a hosted node API). Mocha testnet only.
# CELESTIA_RPC_URL=http://127.0.0.1:26658
# CELESTIA_AUTH_TOKEN=
CELESTIA_NAMESPACE=shipyardmm

RECEIPTS_PATH=receipts.jsonl
POSTS_PATH=posts.json

# Stripe test-mode keys. Test charges are not revenue.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_AMOUNT_GBP=5.00
CHECKOUT_CUSTOMER_REF=hackathon-team
# STRIPE_SUCCESS_URL=http://localhost:8787/success
# STRIPE_CANCEL_URL=http://localhost:8787/cancel
WEBHOOK_PORT=8787
