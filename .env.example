# Dry-run is the default. It fetches a real 402 quote, writes receipt lines,
# and records a mocked Mocha post. It does not spend TIA or take payment.
# The webhook uses the same switch: dry-run runs mock inference for a paid
# checkout (no Houston call). live uses the real Houston paid call.
DEMO_MODE=dry-run

# Eden wallet that pays Houston Inference. 32-byte hex. Never commit this.
# EDEN_PRIVATE_KEY=0x...

# Hard cap enforced in this process, before any transaction is signed.
# Denominated in TIA, not GBP. Raise it only for money you can lose.
SPEND_CAP_TIA=0.05

# Pounds shown by `npm run models`. Houston's list is USD, so the command
# converts at CoinGecko's USD-per-GBP rate unless GBP_USD is set.
# BUDGET_GBP=20
# GBP_USD=1.338835

# Optional second cap in USD, using the TIA/USD price inside the 402 quote.
# SPEND_CAP_USD=1

HOUSTON_BASE_URL=https://inference.bot.fun/v1
HOUSTON_MODEL=qwen/qwen-flash
HOUSTON_MAX_TOKENS=32
# EIP-191 personal_sign over the raw paymentId bytes. Confirmed on the funded run.
# nonce is only the fallback, used when HOUSTON_RETRY_OTHER_SIGN_FIELD=1 rejects this signature.
HOUSTON_SIGN_FIELD=paymentId
# If the paid retry is rejected as the wrong signer, retry once over the nonce
# on the same paymentId. Does not send a second deposit.
# HOUSTON_RETRY_OTHER_SIGN_FIELD=1

# Eden JSON-RPC used by preflight for chain id and balance. Not a broadcast path.
# EDEN_RPC_URL=https://rpc.eden.gateway.fm/

# Live runs write a redacted HTTP trace here. Gitignored. Never contains the private key.
# TRACE_DIR=traces

# Pin. deposit/build must target this contract or the client refuses to sign.
ESCROW_ADDRESS=0x65d77c98E73DFbEA91eCb72B27c9753e186a94c8

# Mocha blobs go through celestia/mocha-helper (npm run celestia:build).
# Leave CELESTIA_RPC_URL unset for that path. Set it only to use your own
# celestia-node JSON-RPC instead of the public Mocha endpoints.
# CELESTIA_RPC_URL=http://127.0.0.1:26658
# CELESTIA_AUTH_TOKEN=
# CELESTIA_HELPER=celestia/mocha-helper
# CELESTIA_KEYRING=celestia-keys
# CELESTIA_KEY_NAME=shipyard
# CELESTIA_DA_URL=https://public-endpoint.celestia-mocha.quiknode.pro
# CELESTIA_CORE_GRPC=public-endpoint.celestia-mocha.quiknode.pro:9090
# CELESTIA_DA_TLS=true
# CELESTIA_CORE_TLS=true
CELESTIA_NAMESPACE=shipyardmm

RECEIPTS_PATH=receipts.jsonl
POSTS_PATH=posts.json
# Checkout task, status, and result. Gitignored.
# JOBS_PATH=jobs.json

# Stripe test-mode keys. Test charges are not revenue.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_AMOUNT_GBP=5.00
CHECKOUT_CUSTOMER_REF=hackathon-team
# STRIPE_SUCCESS_URL=http://localhost:8787/success
# STRIPE_CANCEL_URL=http://localhost:8787/cancel
WEBHOOK_PORT=8787
