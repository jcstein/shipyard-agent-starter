{
  "name": "shipyard-agent-starter",
  "version": "0.1.0",
  "description": "Hands-on starter for SHIPYARD MAKE ME MONEY: pay Houston Inference on Eden, log receipts, post them to Celestia Mocha.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "demo": "node --env-file-if-exists=.env src/demo.ts",
    "preflight": "node --env-file-if-exists=.env src/preflight-cli.ts",
    "verify": "node --env-file-if-exists=.env src/verify.ts",
    "post": "node --env-file-if-exists=.env src/post.ts",
    "celestia:build": "cd celestia && GOTOOLCHAIN=go1.25.1 go build -o mocha-helper .",
    "celestia:address": "node --env-file-if-exists=.env src/celestia-cmd.ts address",
    "celestia:head": "node --env-file-if-exists=.env src/celestia-cmd.ts head",
    "checkout": "node --env-file-if-exists=.env src/checkout.ts",
    "webhook": "node --env-file-if-exists=.env src/webhook.ts",
    "live": "node --env-file-if-exists=.env src/live.ts",
    "human": "node --env-file-if-exists=.env src/human.ts",
    "models": "node --env-file-if-exists=.env src/models.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "ethers": "^6.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "eslint": "^10.13.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
